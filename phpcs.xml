<?xml version="1.0"?>
<ruleset name="Custom Rules">
    <description>Disable end of file newline check for phpcs</description>
    <rule ref="PSR12">
        <!-- Mematikan aturan baris baru di akhir file agar tidak merah lagi -->
        <exclude name="PSR2.Files.EndFileNewline.NoneFound"/>
    </rule>
</ruleset>
